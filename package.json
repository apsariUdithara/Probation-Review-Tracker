{
  "name": "probation-review-tracker",
  "version": "1.0.0",
  "description": "Backend service for tracking employee probation reviews",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:unit": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project unit",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts up",
    "migrate:down": "node --env-file-if-exists=.env scripts/migrate.ts down",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apsariUdithara/Probation-Review-Tracker.git"
  },
  "bugs": {
    "url": "https://github.com/apsariUdithara/Probation-Review-Tracker/issues"
  },
  "homepage": "https://github.com/apsariUdithara/Probation-Review-Tracker#readme",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
